{
  "title": "Scout",
  "uid": "scout-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Container up",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "targets": [
        { "expr": "scout_container_up", "legendFormat": "{{service}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "down", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "up", "color": "green" } } }
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Container CPU %",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "scout_container_cpu_percent", "legendFormat": "{{service}}" }
      ]
    },
    {
      "id": 3,
      "title": "Container memory (MB)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "scout_container_mem_bytes / 1024 / 1024", "legendFormat": "{{service}}" }
      ]
    },
    {
      "id": 4,
      "title": "Restart count",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "scout_container_restart_count", "legendFormat": "{{service}}" }
      ]
    },
    {
      "id": 5,
      "title": "DDS probe healthy",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "scout_dds_probe_ok" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "failing", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "ok", "color": "green" } } }
          ]
        }
      }
    },
    {
      "id": 6,
      "title": "ROS topic Hz",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 18 },
      "targets": [
        { "expr": "scout_ros_topic_hz", "legendFormat": "{{topic}}" }
      ]
    },
    {
      "id": 7,
      "title": "DDS publisher count",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "targets": [
        { "expr": "scout_ros_topic_publisher_count", "legendFormat": "{{topic}}" }
      ]
    },
    {
      "id": 8,
      "title": "DDS subscriber count",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "targets": [
        { "expr": "scout_ros_topic_subscriber_count", "legendFormat": "{{topic}}" }
      ]
    }
  ]
}

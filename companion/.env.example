# cp .env.example .env and set:
# The Pi's LAN address (scout.local). mDNS names don't resolve inside the
# container reliably — use the IP.
PI_IP=192.168.1.100

# Image pin (ADR-0027): companion images resolve to
# ghcr.io/bg-bgi/<name>:$COMPANION_TAG. update.sh writes the deployed commit's
# sha here when driven by the deploy workflow — don't set it by hand; leave
# unset for :latest (main).
# COMPANION_TAG=

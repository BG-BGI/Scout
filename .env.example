# Scout scenario profile (ADR-0010): default | tight_tunnel.
# Compose interpolates this into every stack's launch command, so one line
# switches nav2 + slam + realsense together. Copy to .env and edit to switch:
#   cp .env.example .env   # then set SCOUT_PROFILE=tight_tunnel
SCOUT_PROFILE=default

# Companion VM address (ADR-0021), consumed by fleet_status for the health
# panel. Leave empty when no companion exists — the panel hides and nothing
# else changes.
COMPANION_HOST=

# Image pin (ADR-0027): every scout image resolves to
# ghcr.io/bg-bgi/<name>:$SCOUT_TAG. scripts/deploy-pi.sh writes the deployed
# commit's sha here — don't set it by hand; leave unset for :latest (main).
# SCOUT_TAG=

# Schindler RBL elevator API (ADR-0030). Empty base URL = elevator tools
# disabled. Certs live in gitignored secrets/schindler/ (mounted :ro into
# scout_skills). Sandbox: use the developer-portal zip's PEM+key as-is —
# extracting from the .p12 with -clcerts drops the CA chain and the sandbox
# nginx rejects the handshake (if extracting: openssl pkcs12 -in x.p12 -out
# client.pem -nokeys -passin pass:  — no -clcerts; add -legacy on OpenSSL 3).
# SCHINDLER_BASE_URL=https://sandbox.schindler.com/robots/v1
# SCHINDLER_BEARER=
# SCHINDLER_TLS_VERIFY=true    # true|false|CA path (real PORT Gateway = private CA)
# SCHINDLER_IDENTITY=colab@schindler.com   # sandbox REQUIRES identity on calls

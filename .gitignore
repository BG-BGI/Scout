*.SLDASM/*
meshes/scripts/venv/
meshes/scripts/backup/
venv/
backup/
**/__pycache__/*
scout/imu_calib/

# Saved maps: the serialized pose graphs slam_toolbox loads, and the nav2-style grids
# it exports. The maps/ directory itself is tracked (see maps/.gitkeep) because it must
# exist before a save can succeed.
maps/*.posegraph
maps/*.data
maps/*.pgm
maps/*.yaml
# Runtime state written into the tracked maps/ dir by patrol_capture and
# scout-skills (waypoint store + AprilTag registry) — never committed.
maps/waypoints.json
maps/tags.db
# Zone store + derived nav2 filter masks (zone_manager, ADR-0019). The
# zone_*.pgm/.yaml are already covered by the *.pgm/*.yaml lines above.
maps/zones.json
captures/*
!captures/.gitkeep

# uv/pytest local artifacts
.venv/
.pytest_cache/

# Local profile selection (see .env.example); never committed.
.env
